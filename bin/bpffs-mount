#!/bin/bash
# bpffs-mount — expose Android's bpffs inside the Kali chroot, so iptables works.
#
# It must be a BIND of Android's instance, and --no-canonicalize is mandatory: bpffs uses
# mount_nodev so a fresh `mount -t bpf` is an independent EMPTY pin namespace, and
# util-linux realpath()s the source, collapsing /proc/1/root back to "/". Both wrong forms
# return exit 0, which is why nothing here is verified by exit code.
#
# Why netd's pins make every filter/mangle write fail: /root/docs/IPTABLES-BPFFS.md.
set -uo pipefail

TARGET=/sys/fs/bpf
SOURCE=/proc/1/root/sys/fs/bpf
MIN_PINS=1

# ------------------------------ help rendering --------------------------------
# The tty test and the width are taken ONCE here at the top level, where fds
# 0/1/2 are still the terminal. Inside a $( ) or a `while ... done < file` loop
# fd 1 is a pipe, so a tty test there answers "not a terminal" and `tput cols`
# falls back to the terminfo default of 80. A non-tty gets that 80 deliberately,
# so a redirected help screen is reproducible.
if [ -t 1 ]; then _TTY=1; else _TTY=0; fi
_TERM_COLS=80
if [ "$_TTY" -eq 1 ]; then
    _TERM_COLS="$(tput cols 2>/dev/null)"
    [ -n "$_TERM_COLS" ] || _TERM_COLS="${COLUMNS:-80}"
fi
case "$_TERM_COLS" in ''|*[!0-9]*) _TERM_COLS=80 ;; esac

_cols() {
    local c="$_TERM_COLS"
    [ "$c" -lt 36 ]  && c=36
    [ "$c" -gt 100 ] && c=100
    printf '%s' "$c"
}

# _wrap <width> <first-indent> <next-indent> <text...>
_wrap() {
    local w="$1" pre="$2" nxt="$3"; shift 3
    local line="" word avail glob=1
    local -a words=()
    case "$-" in *f*) glob=0 ;; esac
    set -f; words=( $* ); [ "$glob" -eq 1 ] && set +f
    [ "${#words[@]}" -eq 0 ] && return 0
    for word in "${words[@]}"; do
        avail=$(( w - ${#pre} )); [ "$avail" -lt 8 ] && avail=8
        if [ -z "$line" ]; then
            line="$word"
        elif [ $(( ${#line} + 1 + ${#word} )) -le "$avail" ]; then
            line="$line $word"
        else
            printf '%s%s\n' "$pre" "$line"; pre="$nxt"; line="$word"
        fi
    done
    printf '%s%s\n' "$pre" "$line"
}

_h_title() { _wrap "$(_cols)" "" "  " "$*"; }
_h_sec()   { printf '\n%s\n' "$1"; }
_h_prose() { _wrap "$(_cols)" "  " "  " "$*"; }
_h_gap()   { printf '\n'; }

# _h_rows <label> <desc> [<label> <desc> ...]
# Two columns while the description still gets MIN_DESC characters; below that
# the row STACKS -- label on its own line, description indented beneath. Narrow
# is not the same as broken.
_h_rows() {
    local w labw=0 min=24 i j lab desc head pad
    w="$(_cols)"
    i=1; while [ "$i" -le "$#" ]; do lab="${!i}"
        [ "${#lab}" -gt "$labw" ] && labw="${#lab}"; i=$((i+2)); done
    i=1
    while [ "$i" -le "$#" ]; do
        j=$((i+1)); lab="${!i}"; desc=""; [ "$j" -le "$#" ] && desc="${!j}"
        if [ -z "$desc" ]; then
            printf '  %s\n' "$lab"
        elif [ $(( w - labw - 5 )) -ge "$min" ]; then
            printf -v head '  %-*s   ' "$labw" "$lab"
            printf -v pad  '%*s' "${#head}" ''
            _wrap "$w" "$head" "$pad" "$desc"
        else
            printf '  %s\n' "$lab"
            _wrap "$w" "      " "      " "$desc"
        fi
        i=$((i+2))
    done
}

# _h_lit <command> <note> [<command> <note> ...] -- commands are never wrapped.
# The comment column is the longest command that still leaves room for the LONGEST
# note in the block. Two consequences, both deliberate:
#   * it is derived, never declared, so adding a longer command cannot break it;
#   * the decision is per BLOCK, not per row, so a block never comes out half
#     aligned and half stacked. A command too long for the column keeps its note
#     on the line beneath, and is still emitted whole.
_h_lit() {
    local w cmdw=0 notew=0 i j cmd note
    w="$(_cols)"
    i=2; while [ "$i" -le "$#" ]; do note="${!i}"
        [ "${#note}" -gt "$notew" ] && notew="${#note}"; i=$((i+2)); done
    i=1; while [ "$i" -le "$#" ]; do cmd="${!i}"
        if [ $(( 2 + ${#cmd} + 3 + 2 + notew )) -le "$w" ] && [ "${#cmd}" -gt "$cmdw" ]; then
            cmdw="${#cmd}"
        fi
        i=$((i+2)); done
    i=1
    while [ "$i" -le "$#" ]; do
        j=$((i+1)); cmd="${!i}"; note=""; [ "$j" -le "$#" ] && note="${!j}"
        if [ -z "$note" ]; then
            printf '  %s\n' "$cmd"
        elif [ "${#cmd}" -le "$cmdw" ]; then
            printf '  %-*s   # %s\n' "$cmdw" "$cmd" "$note"
        else
            printf '  %s\n' "$cmd"
            _wrap "$w" "      # " "      # " "$note"
        fi
        i=$((i+2))
    done
}

# ---------------------------------- help --------------------------------------
do_help() {
    _h_title "bpffs-mount -- bind Android's bpffs into the chroot, so iptables filter/mangle writes work."

    _h_sec "USAGE"
    _h_lit "bpffs-mount [start|stop|status]" "start is the default"

    _h_sec "CHAIN"
    _h_prose "Run this BEFORE any iptables filter or mangle write on this box. Without it every write fails with the misleading \"No chain/target/match by that name.\", including the ones lanmitm and rogueap need, so both tools depend on it."
    _h_gap
    _h_prose "\`bpffs-mount status\` is the precondition check. Mounts do not survive a reboot, so this is once per boot."

    _h_sec "VERBS"
    _h_rows \
        "start"  "bind Android's bpffs in. Idempotent, and the default when you give no verb" \
        "stop"   "unmount it. iptables filter/mangle writes fail again afterwards" \
        "status" "read-only: is it mounted, is the fstype really bpf, and how many pins are visible"

    _h_sec "TYPICAL RUN"
    _h_lit \
        "bpffs-mount status" "mounted already?" \
        "bpffs-mount start" "idempotent; needs root" \
        "iptables -N MYCHAIN" "this now succeeds" \
        "bpffs-mount status" "expect a pin count well above zero"

    _h_sec "COST"
    _h_prose "It mounts one filesystem and touches no rule. The mount is a BIND of the instance Android already has, so the pins are SHARED, not copied -- do not treat them as yours."
    _h_gap
    _h_prose "stop leaves netd's own rules in place but makes every further iptables filter/mangle write fail again."

    _h_sec "EXIT"
    _h_rows \
        "0" "did what was asked. For status: bound and usable" \
        "1" "refused, or a probe failed -- and for status, the WRONG filesystem is mounted at the target" \
        "2" "a read-only verb found a state needing action. For status: NOT mounted, so run start"

    _h_sec "SEE ALSO"
    _h_rows \
        "lanmitm --help"     "LAN MITM; needs this mounted first" \
        "rogueap --help"     "rogue AP; its preflight checks this"
}

die() { echo "bpffs-mount: $*" >&2; exit 1; }

# Is $TARGET a real bpffs mount (not the sysfs decoy a canonicalised bind leaves)?
is_mounted() { grep -qE "^[^ ]+ ${TARGET} bpf " /proc/mounts; }
# Something is mounted there, but it is the wrong filesystem.
is_wrong_fs() { grep -qE "^[^ ]+ ${TARGET} " /proc/mounts && ! is_mounted; }
pin_count()  { ls "$TARGET" 2>/dev/null | wc -l; }

# The WRONG filesystem at $TARGET exits 1, not 2: lanmitm die()s on it and rogueap FAILs
# it, so the estate treats the decoy as an error rather than as work outstanding.
do_status() {
    # A probe that cannot RUN is not a negative result. Without this guard an unreadable
    # /proc/mounts falls through all three tests to the "not mounted" branch and would
    # claim 2 -- i.e. assert a state, and an actionable one, on no evidence at all.
    if ! grep -qs . /proc/mounts; then
        echo "bpffs: cannot read /proc/mounts -- mount state UNKNOWN (the probe failed, this is not a 'not mounted')" >&2
        return 1
    fi
    if is_mounted; then
        echo "bpffs: mounted at $TARGET ($(pin_count) pins, netd_shared: $(ls "$TARGET/netd_shared" 2>/dev/null | wc -l))"
        return 0
    elif is_wrong_fs; then
        echo "bpffs: WRONG filesystem mounted at $TARGET -> $(grep -E "^[^ ]+ ${TARGET} " /proc/mounts)" >&2
        return 1
    else
        echo "bpffs: not mounted (iptables filter/mangle writes will fail with ENOENT)" >&2
        return 2
    fi
}

do_start() {
    is_mounted && { [ "${QUIET:-0}" = 1 ] || do_status; return 0; }

    [ "$(id -u)" -eq 0 ] || die "must be root"

    # Clear the sysfs decoy from a previous bad attempt, if present.
    if is_wrong_fs; then
        echo "bpffs-mount: clearing wrong filesystem at $TARGET" >&2
        umount "$TARGET" || die "could not umount stale $TARGET"
    fi

    [ -d "$SOURCE" ] || die "$SOURCE missing -- is PID 1 Android's init?"
    mkdir -p "$TARGET"

    mount --no-canonicalize --bind "$SOURCE" "$TARGET" || die "bind failed"

    # Verify by fstype, never by exit code: a canonicalised bind returns 0 and leaves sysfs.
    is_mounted || { umount "$TARGET" 2>/dev/null; die "bound, but fstype is not bpf (canonicalisation trap?)"; }

    local n; n=$(pin_count)
    [ "$n" -ge "$MIN_PINS" ] || { umount "$TARGET"; die "mounted but only $n pins visible -- wrong instance?"; }

    [ "${QUIET:-0}" = 1 ] || echo "bpffs: mounted at $TARGET ($n pins)"
}

do_stop() {
    is_mounted || { echo "bpffs: not mounted" >&2; return 0; }
    [ "$(id -u)" -eq 0 ] || die "must be root"
    umount "$TARGET" || die "umount failed"
    echo "bpffs: unmounted (iptables filter/mangle writes will fail again)"
}

case "${1:-start}" in
    start|mount|up) do_start ;;
    stop|umount|down) do_stop ;;
    status)           do_status ;;
    -h|--help|help)   do_help ;;
    --help-full)      die "there is one help screen: bpffs-mount --help" ;;
    *) die "unknown action '$1' (try --help)" ;;
esac
